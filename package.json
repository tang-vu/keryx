{
  "name": "keryx",
  "version": "0.19.0",
  "private": true,
  "description": "Keryx — a citation-toll reading agent. Pays creators every time their work is cited, in USDC on Arc.",
  "scripts": {
    "dev": "next dev -p 3939",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 3939",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contracts": "hardhat --tsconfig tsconfig.hardhat.json test",
    "test:watch": "vitest",
    "eval:agent": "node --import tsx --no-warnings scripts/eval-agent.mts",
    "eval:agent:ci": "node --import tsx --no-warnings scripts/eval-agent.mts --json",
    "generate-wallets": "node --import tsx --no-warnings scripts/generate-wallets.mts",
    "seed-sources": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/seed-sources.mts",
    "ask": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/ask.mts",
    "demo": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/demo-full-cycle.mts",
    "seed": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/seed-engine.mts",
    "register-onchain": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/register-existing-source-onchain.mts",
    "metrics": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/metrics.mts",
    "preflight": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/preflight.mts",
    "arc:update": "node --import tsx --no-warnings scripts/arc-update.mts",
    "verify:receipt": "node --import tsx --no-warnings scripts/verify-research-receipt.mts",
    "a2a": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/a2a-client.mts",
    "mcp": "node --import tsx --no-warnings --env-file-if-exists=.env.local mcp/keryx-mcp-server.mts",
    "web": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/web-client.mts",
    "deploy": "bash scripts/deploy-vps.sh",
    "redeploy": "bash scripts/redeploy-vps.sh",
    "tunnel": "cloudflared tunnel --url http://localhost:3939",
    "backup": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/backup-db.mts",
    "check-treasury": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/check-treasury.mts",
    "check-registry": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/check-registry.mts",
    "check-llm": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/check-llm.mts",
    "check-dispatches": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/check-dispatches.mts",
    "check-settlement": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/check-settlement.mts",
    "reconcile-payments": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/reconcile-payments.mts",
    "acknowledge-pending": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/acknowledge-pending-payment.mts",
    "register-discord": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/register-discord-commands.mts",
    "register-telegram": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/register-telegram-webhook.mts",
    "withdraw": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/withdraw.mts",
    "testmint": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/testmint-topup.mts",
    "refresh-feeds": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/refresh-feeds.mts",
    "local-caller": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/local-caller-daemon.mts",
    "migrate-ipfs": "node --import tsx --no-warnings --env-file-if-exists=.env.local scripts/migrate-content-to-ipfs.mts",
    "pack:extension": "node --import tsx --no-warnings scripts/pack-extension.mts",
    "grant:media": "node --env-file-if-exists=.env.local scripts/create-circle-grant-media.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@circle-fin/adapter-viem-v2": "^1.16.0",
    "@circle-fin/unified-balance-kit": "^1.4.1",
    "@circle-fin/x402-batching": "^2.0.4",
    "@coral-xyz/anchor": "^0.32.1",
    "@metamask/connect-evm": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@scalar/nextjs-api-reference": "^0.11.4",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.101.0",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.577.0",
    "next": "^16.3.2",
    "pinata": "^2.5.6",
    "radix-ui": "^1.4.3",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rss-parser": "^3.13.0",
    "siwe": "^3.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "topojson-client": "^3.1.0",
    "undici": "^8.9.0",
    "viem": "^2.47.1",
    "wagmi": "^3.6.17",
    "world-atlas": "^2.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-viem": "^2.1.3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.2",
    "hardhat": "^2.28.6",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "axios": "1.18.1",
    "lodash": "4.18.1",
    "next": {
      "sharp": "0.35.3"
    }
  }
}
