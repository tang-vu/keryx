# ─── Keryx environment ───
# Copy to .env.local and fill in. .env.local is gitignored. Never commit real keys.

# ── LLM (the agent's reasoning brain) ──
# Provider priority: Anthropic > DeepSeek > MiMo > enabled Cloudflare > OFFLINE heuristic.
ANTHROPIC_API_KEY=
# DeepSeek — the default workhorse. A failed step crosses to MiMo when configured.
DEEPSEEK_API_KEY=
# Xiaomi MiMo — a second picker and failover tier on its own key (OpenAI-compatible). If it is the
# only configured provider, it becomes the default real engine rather than silently running offline.
MIMO_API_KEY=
KERYX_MIMO_BASE_URL=
# Optional experimental Cloudflare Workers AI tier. Use an account-restricted Workers AI API
# token, never a CLI OAuth/refresh token. Account id is 32 lowercase hexadecimal characters.
# Enabled public research may send prompts/source excerpts to Cloudflare after existing tiers fail.
# Keep Workers AI on its free plan to enforce the vendor's daily Neuron cap; do not auto-upgrade.
KERYX_CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional ordered allowlist of real fallback tiers. Omitted providers are deliberately disabled;
# invalid/duplicate names are ignored. Empty or all-invalid keeps anthropic,deepseek,mimo,cloudflare.
KERYX_LLM_PROVIDER_ORDER=anthropic,deepseek,mimo,cloudflare
# Per-provider request deadline and DB-shared provider/step circuit. When a real alternate exists,
# one exhausted call opens for 30m; single-provider installs use the two-failure threshold. Failed
# half-open probes double the cooldown up to 4h. Timed-out requests are aborted before failover.
KERYX_LLM_TIMEOUT_MS=60000
KERYX_LLM_CIRCUIT_FAILURES=2
KERYX_LLM_CIRCUIT_COOLDOWN_MS=1800000
KERYX_LLM_CIRCUIT_MAX_COOLDOWN_MS=14400000
# Models (optional overrides; defaults are deepseek-v4-flash when DeepSeek is the provider)
KERYX_LLM_MODEL=
KERYX_SYNTHESIS_MODEL=
# ── Database ──
# If SUPABASE vars are set → Supabase adapter (prod/deploy). Else → local SQLite at ./data/keryx.sqlite (dev).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after 0077 migration and all public sellers run debit-admission code.
KERYX_MONTHLY_ENABLED=0

# ── Owner-managed testnet wallets ──
# The legacy generate-wallets command is retired. Set secrets privately; never print keys,
# replace existing custody or commit environment files. Retain owner recovery records/backups.
# SELLER = platform payee. FUNDER = funds the separately provisioned persistent treasury wallet.
# Caller-owned buyer/stdio keys use KERYX_BUYER_PRIVATE_KEY in their documented private env.
# See docs/treasury-wallet-custody.md and docs/buyer-agent.md; offline dev needs no keys.
SELLER_ADDRESS=
# Server-only reservation set: comma-separated current AND retired private research payees (max 32).
# Must differ from SELLER_ADDRESS. Invalid settings fail public payment admission closed.
# Leave empty until provisioning a private merchant; this does not enable private research.
# Preserve the set through rotations/restores; never repurpose these wallets for public creator payouts.
KERYX_PRIVATE_RESEARCH_RESERVED_PAYEES=
# Restricted private purchasing stays off until worker and owner-pilot acceptance.
# See docs/private-worker.md for the separate operator configuration requirements.
KERYX_PRIVATE_PURCHASE_ENABLED=0
KERYX_PRIVATE_PURCHASE_PAYERS=
SELLER_PRIVATE_KEY=
AGENT_FUNDER_ADDRESS=
AGENT_FUNDER_PRIVATE_KEY=

# ── Chain config (Arc testnet only) ──
# Network id, Gateway APIs, explorer, and browser chain are pinned to Arc testnet. Mainnet needs a
# reviewed multi-file migration and explicit approval; there is intentionally no one-variable flip.
# Server-only. A tokenized `arc-canteen rpc-url` may be used here so Arc reads are attributable;
# keep that credential in .env.local and never expose it through a NEXT_PUBLIC_* variable or logs.
KERYX_RPC_URL=https://rpc.testnet.arc.network
# WebSocket RPC for the indexer's live log subscription (read-only). Leave unset for the
# public Arc endpoint; set to an empty string to disable pushes (heartbeat-poll only).
# KERYX_RPC_WS_URL=wss://rpc.testnet.arc.network
KERYX_USDC_ADDRESS=0x3600000000000000000000000000000000000000
KERYX_GATEWAY_WALLET=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
# Normal mainnet session cashout stays closed unless both block-window settings are supplied
# with the same owner-reviewed positive integer. NEXT_PUBLIC_* is compiled into the worker;
# rebuilding is required when this policy changes. Do not copy test fixture values as policy.
# KERYX_WITHDRAWAL_MAX_AHEAD_BLOCKS=<reviewed positive integer>
# NEXT_PUBLIC_KERYX_WITHDRAWAL_MAX_AHEAD_BLOCKS=<same reviewed positive integer>
# KERYX_WITHDRAWAL_MAX_PROCESSING_LAG_BLOCKS=<reviewed nonnegative integer>
# KERYX_WITHDRAWAL_MAX_FEE_MICROS=<reviewed nonnegative integer micro-USDC>
# NEXT_PUBLIC_KERYX_SETTLEMENT_WALLET: the wallet whose ArcScan page the UI links as on-chain proof
# of settlement (the "Settled · USDC on Arc ↗" / "on-chain ↗" links). Gateway settlements are batched,
# so per-payment IDs are Circle UUIDs (not /tx/-resolvable) — this address shows the real batched
# settlement txs instead. Set to the agent's funded treasury/spend wallet for the sharpest proof.
# When unset, the UI falls back to Circle's Gateway contract above (still valid on-chain proof).
NEXT_PUBLIC_KERYX_SETTLEMENT_WALLET=

# ── Agent economics (USDC) ──
KERYX_DEFAULT_BUDGET=0.05          # default per-query budget
KERYX_CITATION_POOL_RATIO=0.5      # share of budget reserved for weighted citation rewards
KERYX_DEFAULT_FETCH_PRICE=0.002    # default per-source access toll for new sources
KERYX_A2A_FEE=0.02                 # Quick-mode A2A orchestration fee (creator cap added separately)
KERYX_A2A_DEEP_FEE=0.05            # Deep-mode A2A orchestration fee
KERYX_A2A_MAX_BUDGET=0.5           # hard maximum prepaid creator-spend cap per A2A call
KERYX_MAX_ATTENTION_SOURCES=4      # paid + cached reads admitted into one synthesis context
KERYX_MIN_CACHE_EXPECTED_VALUE=0.45 # cached reads below this EV are skipped despite zero toll
KERYX_MIN_PUBLIC_READ_EXPECTED_VALUE=0.12 # original public READ preview ranking floor; not measured coverage
KERYX_ANON_MAX_BUDGET=0.1          # treasury-funded ceiling per anonymous dispatch
KERYX_SESSION_ASK_MAX_BUDGET=0.25  # per-dispatch ceiling inside the remaining browser grant cap

# ── App ──
# Public origin embedded in the x402 endpoint URLs (source/cite/agent) that buyers & A2A callers hit.
# On the live instance this MUST be the public domain, not localhost — e.g. https://keryx.cc
BASE_URL=http://localhost:3939

# Optional audit tag for manually invoked internal clients using `?bot=`.
# Generate: `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
KERYX_BOT_KEY=

# ── Discord front door (optional) ──
# The /ask slash command (app/api/discord/interactions). All three values come from the Discord
# Developer Portal (see docs/discord-bot-setup.md). Unset = endpoint answers 503, feature stays dark.
# DISCORD_PUBLIC_KEY: General Information → Public Key — verifies interaction signatures (runtime).
# DISCORD_APP_ID + DISCORD_BOT_TOKEN: used ONLY by `npm run register-discord`, never at runtime.
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=

# ── Telegram front door (optional) ──
# The /ask bot (app/api/telegram/webhook). Token from @BotFather; the secret is any random string
# Telegram echoes back on every update so the endpoint can authenticate it (see
# docs/telegram-bot-setup.md). Either unset = endpoint answers 503, feature stays dark.
# Generate the secret: `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Slack front door (optional) ──
# The /keryx slash command (app/api/slack/commands). SLACK_SIGNING_SECRET is the app's Signing
# Secret (Basic Information → App Credentials); it verifies every request's HMAC signature. No bot
# token needed — replies ride back over the command's response_url (see docs/slack-bot-setup.md).
# Unset = endpoint answers 503, feature stays dark.
SLACK_SIGNING_SECRET=

# ── Citation email alerts (optional) ──
# The human notify channel beside the webhook: a short "you were cited and paid" email per settled
# citation, owner-opt-in per source from the creator page. Delivery is via Resend's HTTP API
# (https://resend.com — free tier is plenty; verify the sending domain there first).
# Either unset = addresses still save, delivery stays dark (the panel says so).
KERYX_RESEND_API_KEY=
# From header — the address must be on the domain verified in Resend (the live instance
# verified the subdomain updates.keryx.cc), e.g.: Keryx <notify@updates.keryx.cc>
KERYX_EMAIL_FROM=
# Per-source minimum minutes between two alert mails (the engine cites repeatedly; inboxes
# shouldn't pay for that). Default: 60.
KERYX_EMAIL_MIN_INTERVAL_MIN=60

# ── Auth (SIWE + JWT) ──
# JWT_SECRET: ≥32-byte random hex. Required for session cookies to work.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=
# NEXT_PUBLIC_WC_PROJECT_ID: Reown Cloud project ID for WalletConnect mobile wallet support.
# Optional — when unset, only injected wallets (MetaMask, Rabby) are available.
NEXT_PUBLIC_WC_PROJECT_ID=
# KERYX_DEV_WALLETS: comma-separated wallet addresses that receive the 'dev' role at sign-in.
# Lowercased at load time. Example: 0xabc...,0xdef...
KERYX_DEV_WALLETS=

# Scholarly pilot review authority: public wallet addresses only on the application host.
# Independent of dev role and creator wallets; unset blocks paid scholarly activation.
KERYX_SCHOLARLY_REVIEWERS=
# LOCAL OPERATOR MACHINE ONLY. Never deploy this key or use NEXT_PUBLIC_ for it.
# Off-chain review signatures do not require funding. No automatic approval is performed.
KERYX_SCHOLARLY_REVIEWER_PRIVATE_KEY=

# ── On-chain SourceRegistry ──
# Set these after running: npx hardhat run scripts/deploy-source-registry.ts --network arcTestnet
# When unset: indexer is a no-op; register form falls back to DB-direct write (offline dev works).
#
# KERYX_REGISTRY_ADDRESS   — enables the indexer + on-chain creator registration
# NEXT_PUBLIC_*            — also exposed to the browser for wagmi useWriteContract
KERYX_REGISTRY_ADDRESS=
NEXT_PUBLIC_KERYX_REGISTRY_ADDRESS=
#
# READ-only address for the payTo guard: before anything signs or settles, the payee is
# checked against this contract's author/payout wallets. Safe to set on its own — it does
# not wake the indexer or switch registration to on-chain mode. Defaults to the address
# above. Set the NEXT_PUBLIC_ twin too, or the browser cannot run the check.
KERYX_REGISTRY_READ_ADDRESS=
NEXT_PUBLIC_KERYX_REGISTRY_READ_ADDRESS=
# Block number printed by the deploy script — indexer starts scanning from here on cold boot.
# MUST be set whenever KERYX_REGISTRY_ADDRESS is: it defaults to 0, and a cold index from genesis
# would be ~5,000 getLogs calls at the widest range Arc's RPC serves. The live testnet registry
# (0x2e12Fa…) was deployed at block 47474631.
KERYX_REGISTRY_DEPLOY_BLOCK=
# One-time deployer key for the contract deploy only. NOT used for per-source writes.
# Per-source register/update/deactivate are creator-signed from the browser (creator pays gas).
DEPLOYER_PRIVATE_KEY=

# ── IPFS encrypted content (Phase 04) ──
# When set, content items are AES-256-GCM encrypted and pinned to Pinata on ingest.
# Plaintext is released ONLY after x402 payment settles (inside produce() in x402-server.ts).
# When unset: offline dev mode — content served directly from DB, no behavior change.
#
# PINATA_JWT: bearer token from https://app.pinata.cloud → API Keys → New Key
PINATA_JWT=
# CONTENT_MASTER_KEY: 64-char hex (32 bytes) — wraps per-item AES keys. KEEP SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_MASTER_KEY=
# KERYX_IPFS_GATEWAY: public IPFS gateway for fetching encrypted blobs.
# Default: https://gateway.pinata.cloud  (Pinata's public gateway, no auth needed for fetch)
KERYX_IPFS_GATEWAY=

# ── Session grants (Phase 03 — browser co-sign) ──
# TTL in seconds for a user's browser co-sign session grant. After this window the server
# stops honoring sign-requests and the user must re-grant or revoke residual USDC.
# Default: 3600 (1 hour). Shorter = smaller XSS exposure window; longer = fewer re-grants.
# NOTE: No server secret is stored for user sessions — the private key lives only in the
#       browser tab. Setting this to "" uses the default.
KERYX_SESSION_GRANT_TTL=3600

# ── Testnet faucet drip amount ──
# USDC dripped per claim. On Arc, USDC IS the native token and the 0x3600 ERC-20 is
# the SAME balance (just a 6-decimal view), so ONE native transfer credits both gas
# and the ERC-20/x402 view. Default: 1 (covers gas + a small session grant).
KERYX_FAUCET_USDC=1

# ── External onramp (/api/faucet/onramp — unauthenticated, bounded) ──
# One-time auto-funding for a brand-new EXTERNAL caller (the MCP buyer / a judge) so it can pay
# Keryx's toll without the Circle faucet. Bounded by once-per-address + rate limit + a global
# daily cap (the funder holds only testnet USDC). ONRAMP = per-address drip; DAILY_CAP = total/day.
KERYX_ONRAMP_USDC=0.7
KERYX_ONRAMP_DAILY_CAP=20

# ── Traction (optional) ──
# arc-canteen auth is via `arc-canteen login` (GitHub OAuth), not env. circle CLI similar.

# ── Ops: backups + monitoring (optional) ──
# Off-box copy destination for the hourly SQLite backup (npm run backup). Any rclone remote:path,
# e.g. an R2 bucket "r2:keryx-backups" (run `rclone config` once on the box). Unset = local-only
# snapshots under data/backups/ (still rotated, still protect against corruption/accidental delete).
KERYX_BACKUP_REMOTE=
# Local snapshots to retain before rotation deletes the oldest. Default: 48 (2 days hourly).
KERYX_BACKUP_KEEP=48
# Ops alert webhook (Discord or Slack incoming webhook URL). Receives treasury-low + failed-
# settlement alerts. Optional alternative/additional channel beside the private ops bot.
KERYX_ALERT_WEBHOOK=
# Dedicated operations bot, separate from the public TELEGRAM_BOT_TOKEN /ask bot.
# Create a private "Keryx ops" group with the owner and this bot; retain its chat ID privately.
# Both values are required. No public-bot fallback. Restart affected processes after changes.
# Configuration alone does not verify delivery. See docs/telegram-ops-alerts.md.
KERYX_ALERT_TELEGRAM_BOT_TOKEN=
KERYX_ALERT_TELEGRAM_CHAT_ID=
# Pause browser authorization admission during drained journal cutover/rollback.
# Schema activation is separate; see docs/engineering/browser-authorization-cutover.md.
KERYX_BROWSER_AUTHORIZATION_PAUSED=0
# Treasury watchdog thresholds (npm run check-treasury). Alert when the funder wallet's ERC-20
# USDC reserve or native-USDC gas falls below these. Defaults: 2 USDC / 0.02 gas.
KERYX_TREASURY_MIN_USDC=2
KERYX_TREASURY_MIN_GAS=0.02

# Dedicated random 32-byte base64url secret shared with the Free scheduled Worker.
# Empty disables the source upkeep endpoint. Never reuse a payment or user API key.
KERYX_SOURCE_UPKEEP_TOKEN=
# Broad public web search: trusted operator-owned SearXNG /search endpoint with JSON enabled.
# HTTPS public endpoint, or exact http://127.0.0.1:<port>/search for a local trusted service.
# Private research never sends questions to it. Empty means catalog-only; no random public fallback.
KERYX_WEB_SEARCH_URL=
KERYX_WEB_SEARCH_PROVIDER=
# tavily uses fixed basic search, snippets only; an owner-supplied Free account key is required.
# No automatic fallback or account upgrade. Private research never calls either provider.
TAVILY_API_KEY=

# Only enable if an independently configured scheduler promises regular dispatches.
# Caller-driven web/API/MCP research normally remains idle between requests.
KERYX_EXPECT_DISPATCHES=0
