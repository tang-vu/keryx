import { describe,it,expect } from 'vitest';
import { createHash } from 'node:crypto';
import { DatabaseSync } from 'node:sqlite';
import { sqlitePrivacyProjection } from './privacy-projection.mts';
import { erasedRun } from '../../lib/run-privacy/contracts';
import { decodeSqlitePublicQuestionRows } from '../../lib/db/public-question-projection';
import { decodeSqlitePublicSourceHistoryRows,publicSourceHistoryRowsFromRuns } from '../../lib/db/public-source-history-projection';
import { decodeSqlitePublicLearningRows } from '../../lib/db/public-source-learning-projection';
import { auditRunPrivacy } from './audit-run-privacy.mts';
const id='synthetic-privacy-projection',createdAt='2026-01-01T00:00:00.000Z',wallet='0x'+'c1'.repeat(20);
const packet=()=>({id,createdAt,asker:wallet,question:'Private question',answer:'Private answer',engine:'heuristic',budget:0,totalSpent:0,totalToCreators:0,subClaims:[],decisions:[],citations:[],trace:[],paymentMode:'offline'});
function project(input:unknown,recorded:unknown=wallet){const db=new DatabaseSync(':memory:');try{db.exec('CREATE TABLE query_runs(id TEXT,created_at TEXT,asker TEXT,data TEXT)');const wire=typeof input==='string'?input:JSON.stringify(input);db.prepare('INSERT INTO query_runs VALUES(?,?,?,?)').run(id,createdAt,recorded as string,wire);return {p:sqlitePrivacyProjection(db,id),wire};}finally{db.close();}}
describe('private SOURCE privacy/erasure derivatives',()=>{
 it('binds prospective erasure to exact bytes, preserving scalar owner and financial fields',()=>{const run=packet(),{p,wire}=project(run),next=p.eraseProjection as {history:{sha256:string};ownership:{recordedValid:boolean};privacy:{eraseProjection:unknown}};expect(p.sha256).toBe(createHash('sha256').update(wire).digest('hex'));expect(p.eraseWire).toBe(JSON.stringify(erasedRun(run as never)));expect(next.history.sha256).toBe(createHash('sha256').update(p.eraseWire!).digest('hex'));expect(next.ownership.recordedValid).toBe(true);expect(next.privacy.eraseProjection).toBeNull();expect(project(run,null).p.eraseProjection).toMatchObject({ownership:{recordedValid:false}});});
 it('stores allowlist metadata with answer presence instead of the private answer body',()=>{const {p}=project(packet()),base={id,data_bytes:p.dataBytes};expect(p.historyFields).not.toContain('Private answer');const rows=decodeSqlitePublicSourceHistoryRows([{...base,fields:p.historyFields}]);expect(publicSourceHistoryRowsFromRuns(rows)).toEqual([{id,createdAt,hasAnswer:true,citations:[]}]);expect(decodeSqlitePublicQuestionRows([{...base,fields:p.questionFields}],[id])).toEqual([{id,question:'Private question'}]);expect(decodeSqlitePublicLearningRows([{...base,created_at:createdAt,privacy_revision:0,fields:p.learningFields}])[0]).toMatchObject({id,createdAt,decisions:[]});});
 it('preserves escaped unrelated NUL/surrogates and refuses scalar-owner reinterpretation',()=>{const {p}=project({...packet(),uninterpreted:'\0\ud800'});expect(p.valid).toBe(true);expect(p.eraseWire).not.toContain('uninterpreted');const conflict=project({...packet(),asker:'0x'+'d1'.repeat(20)}).p.eraseProjection;expect(conflict).toMatchObject({ownership:{recordedValid:false}});});
 it('audits a pinned transaction with counts and digest only',()=>{const db=new DatabaseSync(':memory:');try{db.exec('CREATE TABLE query_runs(id TEXT,created_at TEXT,asker TEXT,data TEXT)');db.prepare('INSERT INTO query_runs VALUES(?,?,?,?)').run(id,createdAt,wallet,JSON.stringify(packet()));expect(()=>auditRunPrivacy(db,performance.now()+1000)).toThrow();db.exec('BEGIN');const audit=auditRunPrivacy(db,performance.now()+1000);expect(audit).toMatchObject({originalsProjected:1,invalidOriginals:0,missingQuestions:0,missingHistory:0,missingLearning:0,missingArchive:0,missingErasure:0,originalsModified:false,applicationMaterialized:false});expect(JSON.stringify(audit)).not.toContain('Private');expect(()=>auditRunPrivacy(db,performance.now()-1)).toThrow();db.exec('ROLLBACK');}finally{db.close();}});
});
