async function command(bin:'/usr/bin/dpkg-query'|'/usr/bin/dpkg'|'/usr/bin/systemctl',args:readonly string[]){return new Promise<string>((done,fail)=>execFile(bin,[...args],{encoding:'utf8',timeout:5000,maxBuffer:4194304,env:{PATH:'/usr/bin:/bin',HOME:'/root',LANG:'C',LC_ALL:'C'}},(error,out,err)=>{if(error||err)return fail(Error('server1_platform_command_refused'));done(out);}));}
const token=(s:import('node:fs').BigIntStats)=>[s.dev,s.ino,s.mode,s.uid,s.gid,s.nlink,s.size,s.mtimeNs,s.ctimeNs].join(':');
async function parents(path:string){assert.equal(resolve(path),path);for(let p=dirname(path);;p=dirname(p)){const s=await fs.lstat(p);assert(s.isDirectory()&&!s.isSymbolicLink()&&s.uid===0&&s.gid===0&&(s.mode&0o022)===0);assert.equal(await fs.realpath(p),p);if(p==='/')break;}}
async function boundFile(path:string,max:number,mode?:number){await parents(path);const before=await fs.lstat(path,{bigint:true});assert(before.isFile()&&!before.isSymbolicLink()&&before.uid===BigInt(0)&&before.gid===BigInt(0)&&before.nlink===BigInt(1)&&before.size>BigInt(0)&&before.size<=BigInt(max)&&(before.mode&BigInt(0o022))===BigInt(0));if(mode!==undefined)assert.equal(Number(before.mode&BigInt(0o7777)),mode);assert.equal(await fs.realpath(path),path);const fd=await fs.open(path,constants.O_RDONLY|constants.O_NOFOLLOW|constants.O_NONBLOCK);const check=async()=>{assert.equal(token(await fd.stat({bigint:true})),token(before));assert.equal(token(await fs.lstat(path,{bigint:true})),token(before));await parents(path);};try{await check();return{fd,before,check};}catch(e){await fd.close();throw e;}}
async function pinnedBytes(pin:Awaited<ReturnType<typeof boundFile>>){const bytes=Buffer.alloc(Number(pin.before.size));let at=0;while(at<bytes.length){const r=await pin.fd.read(bytes,at,bytes.length-at,at);assert(r.bytesRead>0);at+=r.bytesRead;}assert.equal((await pin.fd.read(Buffer.alloc(1),0,1,at)).bytesRead,0);await pin.check();return bytes;}
