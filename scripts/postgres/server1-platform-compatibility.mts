export async function assertServer1PlatformCurrent():Promise<void>{assert.equal(arguments.length,0);assert.equal(process.platform,'linux');assert.equal(process.arch,'x64');assert.equal(process.version,'v24.22.1');assert.equal(process.getuid?.(),0);assert.equal(sha(await fs.readFile('/etc/machine-id')),MACHINE);const original=object(await protectedJson(PREPARATION,PREPARATION_SHA));assert.equal(original.packageInventorySha256,OLD);const wire=await command('/usr/bin/dpkg-query',['-W','-f='+INVENTORY_FORMAT]);inventory(wire);if(sha(wire)===OLD)return;assert(QUALIFICATION_SHA256!==null,'server1_platform_qualification_unbound');const qualification=await boundFile(QUALIFICATION,65536,0o600);try{const bytes=await pinnedBytes(qualification);assert.equal(sha(bytes),QUALIFICATION_SHA256);const parsed=parseQualification(JSON.parse(new TextDecoder('utf8',{fatal:true,ignoreBOM:true}).decode(bytes)));validateTransition(wire,parsed.p.packageChanges);assert.equal(await command('/usr/bin/dpkg',['--audit']),'');assert.equal(sha(await command('/usr/bin/dpkg-query',['-W','-f='+DEPENDENCY_FORMAT])),parsed.q.currentDependencyGraphSha256);
 assert.equal(await fs.realpath(String(parsed.node.path)),parsed.node.realPath);assert.equal(await fs.realpath(process.execPath),parsed.node.realPath);assert.equal(await fs.realpath(String(parsed.pg.path)),parsed.pg.realPath);const files=await currentFiles(parsed.files);for(const [core,path]of [[parsed.node,'/usr/bin/node'],[parsed.pg,'/usr/lib/postgresql/17/bin/postgres']]as const)assert.equal(object(parsed.files.find(v=>object(v).path===path)).sha256,core.sha256);
 // Addresses and transient qualification-Node PIDs are never identity. The same
 // qualified postmaster/start ticks plus live library-file identities are checked.
 const pid=Number(parsed.pg.postmasterPid);assert.equal((await command('/usr/bin/systemctl',['show','postgresql@17-keryx.service','--property=MainPID','--value'])).trim(),String(pid));const stat=await fs.readFile('/proc/'+pid+'/stat','utf8');assert.equal(stat.slice(stat.lastIndexOf(')')+2).split(' ')[19],parsed.pg.startTicks);const maps=await fs.readFile('/proc/self/maps','utf8');assert(!maps.includes('(deleted)'));for(const line of maps.split('\n')){const path=line.match(/\s(\/[^\n]+)$/)?.[1];if(path&&/\.so(?:\.[0-9]+)*$/.test(path))assert(files.has(await fs.realpath(path)));}
 assert.equal(await command('/usr/bin/dpkg-query',['-W','-f='+INVENTORY_FORMAT]),wire);assert.equal(sha(await command('/usr/bin/dpkg-query',['-W','-f='+DEPENDENCY_FORMAT])),parsed.q.currentDependencyGraphSha256);await qualification.check();}finally{await qualification.fd.close();}
