function permitted(path:string){return ['/usr/bin/node','/usr/lib/postgresql/17/bin/postgres','/etc/ssl/certs/ca-certificates.crt','/etc/postgresql/17/keryx/postgresql.conf','/etc/postgresql/17/keryx/pg_ident.conf','/etc/systemd/system/postgresql@17-keryx.service.d/20-keryx-preparation.conf','/usr/lib/systemd/system/postgresql@.service'].includes(path)||/^\/usr\/lib\/(?:x86_64-linux-gnu|postgresql\/17\/lib)\/(?:[A-Za-z0-9_+.-]+\/)*[A-Za-z0-9_+.-]+\.so(?:\.[0-9]+)*$/.test(path)&&!path.split('/').includes('..');}
async function currentFiles(values:unknown[]){const seen=new Set<string>();let total=0;for(const value of values){const f=object(value);exact(f,['path','sha256','bytes','dev','ino','mtimeNs','ctimeNs','mode','uid','gid']);assert(typeof f.path==='string'&&permitted(f.path)&&!seen.has(f.path));seen.add(f.path);hash(f.sha256);for(const k of ['dev','ino','mtimeNs','ctimeNs'])assert(typeof f[k]==='string'&&/^[0-9]+$/.test(f[k]as string));assert(Number.isSafeInteger(f.bytes)&&Number(f.bytes)>0&&Number(f.bytes)<=268435456);total+=Number(f.bytes);assert(total<=536870912);const pin=await boundFile(f.path,268435456);try{const s=pin.before;assert.equal(s.size.toString(),String(f.bytes));for(const k of ['dev','ino','mtimeNs','ctimeNs']as const)assert.equal(s[k].toString(),f[k]);assert.equal(Number(s.mode&BigInt(0o7777)),f.mode);assert.equal(Number(s.uid),f.uid);assert.equal(Number(s.gid),f.gid);const digest=createHash('sha256'),buffer=Buffer.alloc(1048576);let at=0;for(;;){const {bytesRead}=await pin.fd.read(buffer,0,buffer.length,at);if(!bytesRead)break;if(at===0&&(f.path==='/usr/bin/node'||f.path==='/usr/lib/postgresql/17/bin/postgres'||/\.so(?:\.[0-9]+)*$/.test(f.path)))assert.equal(buffer.subarray(0,4).toString('hex'),'7f454c46');digest.update(buffer.subarray(0,bytesRead));at+=bytesRead;assert(at<=Number(f.bytes));await yieldTimers(0);}assert.equal(at,f.bytes);assert.equal(digest.digest('hex'),f.sha256);await pin.check();}finally{await pin.fd.close();}}
 for(const path of ['/usr/bin/node','/usr/lib/postgresql/17/bin/postgres','/etc/ssl/certs/ca-certificates.crt','/etc/postgresql/17/keryx/postgresql.conf','/etc/postgresql/17/keryx/pg_ident.conf','/etc/systemd/system/postgresql@17-keryx.service.d/20-keryx-preparation.conf','/usr/lib/systemd/system/postgresql@.service'])assert(seen.has(path));return seen;
