  const path='/root/keryx-migration/postgres17-server1-platform-qualification.json',linuxFlags={O_RDONLY:0,O_NOFOLLOW:constants.O_NOFOLLOW??131072,O_NONBLOCK:constants.O_NONBLOCK??2048};let opened=0,closed=0,flags=0;const base={dev:BigInt(1),ino:BigInt(2),mode:BigInt(mode==='group-write'?0o620:0o600),uid:BigInt(mode==='foreign-owner'?1000:0),gid:BigInt(0),nlink:BigInt(mode==='hardlink'?2:1),size:BigInt(100),mtimeNs:BigInt(3),ctimeNs:BigInt(4),isFile:()=>true,isSymbolicLink:()=>mode==='symlink'};
