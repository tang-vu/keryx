  const wire=ts.transpileModule(functions(['parents','boundFile']),{compilerOptions:{target:ts.ScriptTarget.ES2017,module:ts.ModuleKind.None}}).outputText;const run=new Function('assert','fs','constants','dirname','resolve','token',wire+';return boundFile;')(assert,fake,linuxFlags,posix.dirname,posix.resolve,new Function(constant('token'))())as(file:string,max:number,mode:number)=>Promise<{fd:{close():Promise<void>};check():Promise<void>}>;
  if(mode==='pass'){const held=await run(path,65536,0o600);try{await held.check();expect(flags&linuxFlags.O_NOFOLLOW).toBe(linuxFlags.O_NOFOLLOW);}finally{await held.fd.close();}expect(opened).toBe(1);expect(closed).toBe(1);}else{await expect(run(path,65536,0o600)).rejects.toThrow();expect(opened).toBe(mode==='changed-after-open'?1:0);expect(closed).toBe(opened);}
