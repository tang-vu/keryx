import { describe,it,expect } from 'vitest';
import { DatabaseSync } from 'node:sqlite';
import { sqliteOwnershipHistoryProjection } from './ownership-history-projection.mts';
const id='synthetic-projection',createdAt='2026-01-01T00:00:00.000Z',wallet='0x'+'a1'.repeat(20);
function project(wire:string,asker:string|null=null){const db=new DatabaseSync(':memory:');try{db.exec('CREATE TABLE query_runs(id TEXT,created_at TEXT,asker TEXT,data TEXT)');db.prepare('INSERT INTO query_runs VALUES(?,?,?,?)').run(id,createdAt,asker,wire);return sqliteOwnershipHistoryProjection(db,id);}finally{db.close();}}
const base=()=>({id,createdAt,question:'First question',totalSpent:0,totalToCreators:0,paymentMode:'offline',answer:'Private answer'});
describe('independent SQLite ownership SOURCE projection',()=>{
 it('keeps first-key search bytes separate from the last-key summary',()=>{const p=project(JSON.stringify(base()).slice(0,-1)+',"question":"Last question"}');expect(p.questionHex).toBe(Buffer.from('First question').toString('hex'));expect(p.summary?.question).toBe('Last question');expect(p.historyEligible).toBe(true);expect(p.claimedValid).toBe(true);});
 it('distinguishes absent and explicit-null asker, preserving current claim history',()=>{expect(project(JSON.stringify(base())).historyEligible).toBe(true);const p=project(JSON.stringify({...base(),asker:null}));expect(p.historyEligible).toBe(false);expect(p.claimedValid).toBe(false);expect(p.recordedValid).toBe(false);expect(project(JSON.stringify({...base(),asker:null}),wallet).recordedValid).toBe(true);});
 it('retains unrelated escaped NUL/surrogate values and marks invalid summaries separately from private reads',()=>{const p=project(JSON.stringify({...base(),answer:'\0\ud800'}));expect(p.claimedValid).toBe(true);expect(p.summary?.question).toBe('First question');const bad=project(JSON.stringify({...base(),question:'\0'}));expect(bad.summary).toBeNull();expect(bad.claimedValid).toBe(true);});
 it('keeps a null search projection distinct from an empty string and rejects raw invalid UTF8',()=>{expect(project(JSON.stringify({...base(),question:null})).questionHex).toBeNull();expect(project(JSON.stringify({...base(),question:''})).questionHex).toBe('');const db=new DatabaseSync(':memory:');try{db.exec('CREATE TABLE query_runs(id TEXT,created_at TEXT,asker TEXT,data TEXT)');const wire=JSON.stringify(base()),bytes=Buffer.from(wire.replace('Private answer','PLACEHOLDER'));const start=bytes.indexOf('PLACEHOLDER');const bad=Buffer.concat([bytes.subarray(0,start),Buffer.from([255]),bytes.subarray(start+'PLACEHOLDER'.length)]);db.prepare('INSERT INTO query_runs VALUES(?,?,NULL,CAST(? AS TEXT))').run(id,createdAt,bad);expect(()=>sqliteOwnershipHistoryProjection(db,id)).toThrow('Ownership SOURCE original unavailable');}finally{db.close();}});
});
