{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keryx Operator",
  "version": "0.4.6",
  "identifier": "cc.keryx.operator",
  "mainBinaryName": "KeryxOperator",
  "build": {
    "frontendDist": "../dist/ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Keryx Operator",
      "width": 1240,
      "height": 850,
      "minWidth": 760,
      "minHeight": 600,
      "backgroundColor": "#f1e9d7"
    }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico", "../assets/icon.png"],
    "resources": {
      "../dist/helper.cjs": "dist/helper.cjs",
      "../dist/source-commit.txt": "dist/source-commit.txt",
      "../dist/native/": "dist/native/",
      "../dist/runtime/": "dist/runtime/",
      "../dist/ui/": "dist/ui/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
